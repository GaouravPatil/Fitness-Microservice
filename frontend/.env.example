# Development-only proxy targets used by Vite.
# The browser talks to Vite, which forwards to the services over HTTPS and
# skips self-signed certificate checks, so the local CA does not need to be
# trusted by the browser.
VITE_DEV_USER_SERVICE_URL=https://localhost:8081
VITE_DEV_ACTIVITY_SERVICE_URL=https://localhost:8082
VITE_DEV_RECOMMENDATION_SERVICE_URL=https://localhost:8083

# Production API bases, baked in at build time.
# Leave these blank when the frontend and services share an origin and are
# reverse-proxied under /api/users, /api/activities and /api/recommendations.
# For a separately hosted frontend, point them at the public HTTPS services and
# add the frontend origin to CORS_ALLOWED_ORIGINS in the backend .env.
VITE_USER_API_URL=
VITE_ACTIVITY_API_URL=
VITE_RECOMMENDATION_API_URL=
