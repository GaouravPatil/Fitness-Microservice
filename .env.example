# Copy to .env and replace every placeholder before running.

# Shared across userservice, activityservice and aiservice
# Generate an RSA key pair (see README):
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out jwt-private.pem
#   openssl pkcs8 -topk8 -nocrypt -in jwt-private.pem -outform DER | base64 -w0
#   openssl pkey -in jwt-private.pem -pubout -outform DER | base64 -w0
JWT_PRIVATE_KEY=replace-with-base64-pkcs8-private-key
JWT_PUBLIC_KEY=replace-with-base64-x509-public-key
JWT_ISSUER=https://userservice.fitness.local
JWT_AUDIENCE=fitness-api
JWT_KEY_ID=fitness-key-1
JWT_TTL=PT15M
JWT_REFRESH_TTL=P7D
# Comma-separated list so keys can be rotated: new-key,old-key
INTERNAL_API_KEY=replace-with-a-long-random-internal-key
INTERNAL_API_KEYS=replace-with-a-long-random-internal-key
CORS_ALLOWED_ORIGINS=http://localhost:3000

# userservice
DB_URL=jdbc:postgresql://localhost:5432/fitnessdb
DB_USERNAME=postgres
DB_PASSWORD=postgres
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
FLYWAY_ENABLED=true
USERSERVICE_PORT=8081

# activityservice
MONGODB_URI=mongodb://localhost:27017/activityfitness
MONGODB_DATABASE=activityfitness
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=activity-topic
USER_SERVICE_URL=http://USERSERVICE
USER_SERVICE_TIMEOUT=PT3S
ACTIVITY_SERVICE_PORT=8082

# aiservice
AI_MONGODB_URI=mongodb://localhost:27017/airecommendationfitness
AI_MONGODB_DATABASE=airecommendationfitness
KAFKA_CONSUMER_GROUP=aiservice
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_SERVICE_PORT=8083

# service discovery (basic auth is mandatory)
EUREKA_USERNAME=eureka
EUREKA_PASSWORD=replace-with-a-long-random-password
EUREKA_HOST=localhost
EUREKA_BIND_ADDRESS=127.0.0.1
EUREKA_SERVER_PORT=8761

# API docs are disabled unless explicitly enabled (local development only)
SPRINGDOC_ENABLED=false
